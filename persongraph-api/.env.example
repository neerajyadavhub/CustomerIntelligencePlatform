# Copy this file to .env and fill in real values before deploying.

# Leave unset to use local SQLite. Set to a Postgres URL for production,
# e.g. postgresql://user:password@host:5432/dbname
DATABASE_URL=

# "mock" (default) uses seeded local data via MockResolver.
# "segment" switches to SegmentResolver — requires the two keys below
# and finishing the TODOs in app/identity_resolver.py.
RESOLVER_MODE=mock

SEGMENT_API_KEY=
SEGMENT_SPACE_ID=

# "mock" (default) generates a realistic performance curve locally.
# "meta" switches to MetaInsightsProvider — requires the two keys below
# and finishing the TODOs in app/measurement_engine.py.
METRICS_MODE=mock

META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=

# Comma-separated list of browser origins allowed to call the API.
# Default "*" is fine for a public demo; set this for anything real, e.g.
# CORS_ORIGINS=https://app.example.com,https://admin.example.com
CORS_ORIGINS=*

# Container only: port to listen on (default 8000).
PORT=8000

# Demo data. The container loads demo data on start when DATABASE_URL is empty
# (throwaway SQLite) or SEED_DEMO_DATA=true. Seeding WIPES the database, and
# refuses to run against a non-SQLite database unless SEED_ALLOW_RESET=true.
# Never set either of these against a database that holds real data.
SEED_DEMO_DATA=
SEED_ALLOW_RESET=

# Require an API key on all data endpoints. Comma-separated secrets; send as
# "Authorization: Bearer <key>" or "X-API-Key: <key>". Leave empty ONLY for
# local use and the demo. Generate one with: openssl rand -hex 32
API_KEYS=
