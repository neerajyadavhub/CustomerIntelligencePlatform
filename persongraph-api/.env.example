# Copy this file to .env and fill in real values before deploying.

# Leave unset to use local SQLite. Set to a Postgres URL for production,
# e.g. postgresql://user:password@host:5432/dbname
DATABASE_URL=

# "mock" (default) uses seeded local data via MockResolver.
# "segment" switches to SegmentResolver — requires the two keys below
# and finishing the TODOs in app/identity_resolver.py.
RESOLVER_MODE=mock

SEGMENT_API_KEY=
SEGMENT_SPACE_ID=

# "mock" (default) generates a realistic performance curve locally.
# "meta" switches to MetaInsightsProvider — requires the two keys below
# and finishing the TODOs in app/measurement_engine.py.
METRICS_MODE=mock

META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
