# Settings for docker-compose.customer.yml. Copy to .env (never commit .env).

# Database password for the bundled Postgres.
POSTGRES_PASSWORD=change-me

# Required. Every data request must send this key.  openssl rand -hex 32
API_KEYS=

# Your own web origins allowed to call the API from a browser (comma-separated).
CORS_ORIGINS=

# Name of the signal that records marketing consent (1 = opted in).
CONSENT_SIGNAL=marketing_consent

# Meta. Start with mock, switch to live once `app.doctor` passes. See docs/META-SETUP.md
META_MODE=mock
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_API_VERSION=v25.0
META_CONVERSION_ACTION=purchase
